{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinBeautify",
  "version": "0.1.1",
  "identifier": "io.winbeautify.app",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/WinBeautify/clipboard/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Windows 桌面美化与增强工具",
    "longDescription": "任务栏透明/亚克力/云母材质、任务栏歌词与实时频谱、剪贴板历史、任务清单。模块化、事件驱动，常驻后台资源占用极低。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/beautify_taskbar_tap.dll": "beautify_taskbar_tap.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
